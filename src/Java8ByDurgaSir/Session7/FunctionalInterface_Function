____________________________________

f1.andThen(f2).apply(i)
first f1 followed by f2

f1.compose (f2).apply(i)
first f2 and then f1

class Test{
psvm{
Function<Integer, Integer> f1=i->2*i;//4
Function<Integer, Integer> f2=i->i*i*i;//64

sout(f1.andThen(f2).apply(2));//64
sout(f1.compose(f2).apply(2));//16
}
}

